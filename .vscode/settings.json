{
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit",
        "source.fixAll.eslint": "explicit"
    },
    "html.format.indentInnerHtml": true,
    "typescript.format.insertSpaceAfterOpeningAndBeforeClosingEmptyBraces": false,
    "eslint.workingDirectories": ["./client", "./server"],
    "eslint.probe": ["javascript", "typescript", "html", "vue", "markdown"],
    "eslint.validate": ["javascript", "typescript", "html", "vue", "markdown"],
    "cSpell.words": [
        "Aplicator",
        "applicateur",
        "Boardgame",
        "Conflit",
        "Correspondance",
        "Création",
        "doivent",
        "données",
        "échec",
        "Enchantee",
        "Enregistrement",
        "Enregistrer",
        "entrer",
        "Erreur",
        "etre",
        "Faucon",
        "Fermee",
        "gazon",
        "inattendue",
        "inconnue",
        "introuvable",
        "invalide",
        "l'opération",
        "moitie",
        "Outils",
        "placee",
        "Requête",
        "Ressource",
        "retourneur",
        "reussit",
        "serveur",
        "Succès",
        "survenue",
        "Survie",
        "Tous",
        "Tuile",
        "tuiles",
        "typedi",
        "valide"
    ]
}
